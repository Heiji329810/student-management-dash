{
  "name": "student-management-dash",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @student-dash/server\" \"npm run dev -w @student-dash/client\"",
    "build": "npm run build -w shared && npm run build -w @student-dash/server && npm run build -w @student-dash/client",
    "test": "npm run test -w @student-dash/server && node --import tsx --test apps/web/test/*.test.ts",
    "lint": "npm run lint -w @student-dash/client",
    "db:generate": "npm run db:generate -w @student-dash/server",
    "db:migrate": "npm run db:migrate -w @student-dash/server",
    "account:create": "npm run account:create -w @student-dash/server",
    "db:local": "bash scripts/local-postgres.sh",
    "db:initialize": "npm run db:initialize -w @student-dash/server",
    "verify:prepare": "tsx --env-file=.env scripts/prepare-browser.ts",
    "start": "npm run start -w @student-dash/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
